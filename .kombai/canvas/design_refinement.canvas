      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap');\n  @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,400;0,700;1,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #FFF8E7; /* Ivory Mist */\n    font-family: 'Nunito Sans', sans-serif;\n    color: #2A3439; /* Jet Black */\n    margin: 0;\n  }\n\n  .font-heading {\n    font-family: 'Fredoka', sans-serif;\n  }\n\n  /* Claymorphism Card Effect */\n  .clay-card {\n    background: #FFFFFF;\n    border-radius: 40px;\n    box-shadow: \n      inset -10px -10px 20px rgba(0, 0, 0, 0.02),\n      inset 10px 10px 20px rgba(255, 255, 255, 0.5),\n      20px 20px 60px rgba(42, 52, 57, 0.08);\n    border: 2px solid rgba(255, 255, 255, 0.8);\n  }\n\n  /* Puffy Button Effect */\n  .puffy-button {\n    background: #FF7F50; /* Coral Glow */\n    color: white;\n    box-shadow: \n      inset -4px -4px 8px rgba(0, 0, 0, 0.2),\n      inset 4px 4px 8px rgba(255, 255, 255, 0.3),\n      0 10px 20px rgba(255, 127, 80, 0.3);\n    transition: all 0.3s ease;\n  }\n  .puffy-button:hover {\n    transform: translateY(-2px);\n    box-shadow: \n      inset -2px -2px 4px rgba(0, 0, 0, 0.2),\n      inset 2px 2px 4px rgba(255, 255, 255, 0.3),\n      0 15px 30px rgba(255, 127, 80, 0.4);\n  }\n\n  /* Tag Styling */\n  .tag-sticker {\n    padding: 8px 20px;\n    border-radius: 999px;\n    font-weight: 700;\n    font-size: 0.875rem;\n    border: 3px solid white;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);\n    display: inline-block;\n    font-family: 'Fredoka', sans-serif;\n    transition: all 0.2s cubic-bezier(0.175, 0.885, 0.32, 1.275);\n    cursor: default;\n  }\n  .tag-sticker:hover {\n    transform: scale(1.05) rotate(2deg);\n    box-shadow: 0 8px 16px rgba(0, 0, 0, 0.1);\n  }\n\n  /* Polaroid Effect */\n  .polaroid {\n    background: white;\n    padding: 16px 16px 48px 16px;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n    transform: rotate(-2deg);\n    border-radius: 4px;\n  }\n\n  /* Washi Tape Effect */\n  .washi-tape {\n    position: absolute;\n    width: 100px;\n    height: 30px;\n    background: rgba(109, 207, 171, 0.4); /* Minty translucent */\n    top: -15px;\n    left: 50%;\n    transform: translateX(-50%) rotate(2deg);\n    z-index: 10;\n  }\n\n  /* Soft Callout for Objectifs */\n  .soft-callout {\n    background: #E0FFFF; /* Light Cyan */\n    border-radius: 32px;\n    box-shadow: inset 4px 4px 10px rgba(255,255,255,0.6), inset -4px -4px 10px rgba(0,0,0,0.03);\n    border: 2px solid white;\n  }\n\n  /* Plan Step Marker */\n  .step-marker {\n    width: 44px;\n    height: 44px;\n    border-radius: 15px;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    font-weight: 700;\n    font-family: 'Fredoka', sans-serif;\n    box-shadow: \n      inset -2px -2px 4px rgba(0, 0, 0, 0.1),\n      inset 2px 2px 4px rgba(255, 255, 255, 0.5),\n      0 6px 12px rgba(0,0,0,0.06);\n    flex-shrink: 0;\n  }\n\n  /* Document Card */\n  .doc-card {\n    background: #FFFFFF;\n    border-radius: 24px;\n    padding: 16px;\n    box-shadow: \n      inset -4px -4px 8px rgba(0, 0, 0, 0.02),\n      inset 4px 4px 8px rgba(255, 255, 255, 0.8),\n      0 10px 20px rgba(0, 0, 0, 0.04);\n    border: 1px solid rgba(0, 0, 0, 0.02);\n    transition: transform 0.2s ease;\n  }\n  .doc-card:hover { transform: translateY(-2px); }\n\n  .puffy-button-sm {\n    background: #FF7F50;\n    color: white;\n    padding: 10px 16px;\n    border-radius: 14px;\n    font-family: 'Fredoka', sans-serif;\n    font-weight: 600;\n    font-size: 0.875rem;\n    box-shadow: \n      inset -2px -2px 4px rgba(0, 0, 0, 0.2),\n      inset 2px 2px 4px rgba(255, 255, 255, 0.3),\n      0 4px 8px rgba(255, 127, 80, 0.2);\n    transition: all 0.2s ease;\n  }\n  .puffy-button-sm:hover {\n    filter: brightness(1.05);\n  }\n</style>\n\n<div class=\"min-h-[1400px] flex flex-col\" data-kid=\"1\">\n  \n  <header class=\"absolute top-6 left-1/2 -translate-x-1/2 w-[min(1200px,95%)] bg-white/70 backdrop-blur-xl rounded-[28px] shadow-[0_20px_50px_rgba(0,0,0,0.05)] z-50 px-10 py-5 flex justify-between items-center border border-white/40\" data-kid=\"2\">\n    <a href=\"#\" class=\"flex items-center gap-3 no-underline\" data-kid=\"3\">\n      <div class=\"w-12 h-12 flex items-center justify-center\" data-kid=\"4\">\n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/caro-asercion/paper-crane.svg\" class=\"w-10 h-10\" style=\"filter: drop-shadow(0 4px 6px rgba(255,127,80,0.4));\" data-kid=\"5\">\n      </div>\n      <span class=\"font-heading font-bold text-xl tracking-tight text-[#2A3439]\" data-kid=\"6\">Apprenti G&eacute;om&egrave;tre mobile</span>\n    </a>\n    \n    <nav class=\"flex items-center gap-2\" data-kid=\"7\">\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"8\">Accueil</a>\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"9\">Prise en main</a>\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"10\">Modules</a>\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"11\">S&eacute;quences</a>\n      <a href=\"#\" class=\"px-7 py-2.5 bg-[#E0FFFF] rounded-full font-heading font-bold text-[#2A3439] shadow-sm\" data-kid=\"12\">Tous les contenus</a>\n    </nav>\n  </header>\n\n  <main class=\"flex-grow pt-40 pb-20 px-8 max-w-7xl mx-auto w-full\" data-kid=\"13\">\n    \n    \n    <div class=\"relative mb-24\" data-kid=\"14\">\n      <div class=\"inline-block bg-[#2A3439] text-white px-12 py-8 rounded-tr-[40px] rounded-br-[40px] shadow-2xl relative z-10\" data-kid=\"15\">\n        <h1 class=\"font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight max-w-2xl\" data-kid=\"16\">\n          les c&ocirc;t&eacute;s ont &eacute;t&eacute; multipli&eacute;s par un nombre entier.\n        </h1>\n      </div>\n      \n      \n      <div class=\"mt-10 flex flex-wrap gap-4 pl-0\" data-kid=\"17\">\n        <span class=\"tag-sticker bg-[#FFD1DC]\" data-kid=\"18\">P5 - P6</span>\n        <span class=\"tag-sticker bg-[#E0FFFF]\" data-kid=\"19\">S1 &agrave; S3</span>\n        <span class=\"tag-sticker bg-[#C1E1C1]\" data-kid=\"20\">Aire</span>\n        <span class=\"tag-sticker bg-[#FDFD96]\" data-kid=\"21\">Reproduction de figures planes</span>\n        <span class=\"tag-sticker bg-[#B39EB5]\" data-kid=\"22\">Agrandir/R&eacute;tr&eacute;cir</span>\n        <span class=\"tag-sticker bg-[#FFB347]\" data-kid=\"23\">Paver</span>\n        <span class=\"tag-sticker bg-[#AEC6CF]\" data-kid=\"24\">Aire s&eacute;quence</span>\n        <span class=\"tag-sticker bg-[#FFD1DC]\" data-kid=\"25\">P5 - P6</span>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"26\">\n      \n      \n      <article class=\"lg:col-span-8 clay-card p-12 relative overflow-visible\" data-kid=\"27\">\n        \n        \n        <div class=\"soft-callout p-8 mb-10\" data-kid=\"28\">\n          <div class=\"flex items-center gap-4 mb-5\" data-kid=\"29\">\n            <div class=\"w-12 h-12 bg-white rounded-2xl flex items-center justify-center shadow-sm\" data-kid=\"30\">\n              <i class=\"ti ti-target-arrow text-[#FF7F50] text-2xl\" data-kid=\"31\"></i>\n            </div>\n            <h2 class=\"font-heading text-2xl font-bold text-[#2A3439]\" data-kid=\"32\">Objectifs de la s&eacute;quence</h2>\n          </div>\n          <ul class=\"space-y-5 font-body font-medium text-[#2A3439]/80 text-lg\" data-kid=\"33\">\n            <li class=\"flex items-start gap-4\" data-kid=\"34\">\n              <div class=\"w-8 h-8 rounded-full bg-white flex items-center justify-center shrink-0 shadow-sm border border-[#E0FFFF]\" data-kid=\"35\">\n                <i class=\"ti ti-checkbox text-[#FF7F50] text-xl\" data-kid=\"36\"></i>\n              </div>\n              <span class=\"leading-snug\" data-kid=\"37\">Construire des agrandissements de polygones, avec ou sans le support d&rsquo;une grille, pour en d&eacute;couvrir les caract&eacute;ristiques.</span>\n            </li>\n            <li class=\"flex items-start gap-4\" data-kid=\"38\">\n              <div class=\"w-8 h-8 rounded-full bg-white flex items-center justify-center shrink-0 shadow-sm border border-[#E0FFFF]\" data-kid=\"39\">\n                <i class=\"ti ti-checkbox text-[#FF7F50] text-xl\" data-kid=\"40\"></i>\n              </div>\n              <span class=\"leading-snug\" data-kid=\"41\">Comparer l&rsquo;aire d&rsquo;un polygone avec celle de son agrandissement dont les c&ocirc;t&eacute;s ont &eacute;t&eacute; multipli&eacute;s par un nombre entier.</span>\n            </li>\n          </ul>\n        </div>\n\n        <div class=\"prose prose-lg max-w-none text-[#2A3439] leading-relaxed\" data-kid=\"42\">\n          <div class=\"flex flex-col md:flex-row gap-10 items-start mb-12\" data-kid=\"43\">\n            <div class=\"flex-1\" data-kid=\"44\">\n              <p class=\"text-xl font-medium mb-6\" data-kid=\"45\">\n                Dans cet exercice, nous allons explorer comment les figures g&eacute;om&eacute;triques se transforment lorsque leurs dimensions sont multipli&eacute;es par un facteur constant. C'est le concept fondamental de l'agrandissement et du r&eacute;tr&eacute;cissement.\n              </p>\n              <p class=\"mb-6\" data-kid=\"46\">\n                L'agrandissement d'une figure conserve ses angles mais modifie ses longueurs. Si chaque c&ocirc;t&eacute; est multipli&eacute; par 2, le p&eacute;rim&egrave;tre est multipli&eacute; par 2, mais l'aire est multipli&eacute;e par 4 (2 au carr&eacute;).\n              </p>\n            </div>\n            \n            <div class=\"relative w-full md:w-72 shrink-0\" data-kid=\"47\">\n              <div class=\"washi-tape\" data-kid=\"48\"></div>\n              <div class=\"polaroid\" data-kid=\"49\">\n                <img src=\"https://images.unsplash.com/photo-1753024678449-6731f45a872c?auto=format&w=800&q=80&fit=crop\" alt=\"Observation des formes\" class=\"w-full aspect-square object-cover rounded-sm mb-4\" loading=\"lazy\" decoding=\"async\" data-kid=\"50\">\n                <p class=\"font-heading text-center text-gray-500 text-sm italic\" data-kid=\"51\">Observation des formes</p>\n              </div>\n            </div>\n          </div>\n          \n          <h3 class=\"font-heading text-3xl font-bold mt-20 mb-10\" data-kid=\"52\">Plan du d&eacute;roulement</h3>\n          <div class=\"space-y-12 mb-16 relative pl-12 border-l-4 border-dashed border-[#FF7F50]/20\" data-kid=\"53\">\n            <div class=\"relative\" data-kid=\"54\">\n              <div class=\"absolute -left-[70px] top-0 step-marker bg-[#FFD1DC] text-[#2A3439]\" data-kid=\"55\">1</div>\n              <h4 class=\"font-heading text-xl font-bold mb-3 text-[#2A3439]\" data-kid=\"56\">Agrandissements : d&eacute;couverte</h4>\n              <p class=\"text-[#2A3439]/70 leading-relaxed\" data-kid=\"57\">Construire des agrandissements de dessins sur papier point&eacute; (de deux types) et en &eacute;tablir les caract&eacute;ristiques.</p>\n            </div>\n            <div class=\"relative\" data-kid=\"58\">\n              <div class=\"absolute -left-[70px] top-0 step-marker bg-[#E0FFFF] text-[#2A3439]\" data-kid=\"59\">2</div>\n              <h4 class=\"font-heading text-xl font-bold mb-3 text-[#2A3439]\" data-kid=\"60\">Agrandissements : paver pour comparer</h4>\n              <p class=\"text-[#2A3439]/70 leading-relaxed\" data-kid=\"61\">Observer par pavages et d&eacute;coupages ce qu&rsquo;il advient de l&rsquo;aire d&rsquo;un polygone lorsqu&rsquo;on l&rsquo;agrandit en multipliant la longueur de ses c&ocirc;t&eacute;s par deux.</p>\n            </div>\n            <div class=\"relative\" data-kid=\"62\">\n              <div class=\"absolute -left-[70px] top-0 step-marker bg-[#C1E1C1] text-[#2A3439]\" data-kid=\"63\">3</div>\n              <h4 class=\"font-heading text-xl font-bold mb-3 text-[#2A3439]\" data-kid=\"64\">Agrandissements : construire pour g&eacute;n&eacute;raliser</h4>\n              <p class=\"text-[#2A3439]/70 leading-relaxed\" data-kid=\"65\">Construire des agrandissements de c&ocirc;t&eacute;s de longueur double, triple, &hellip; sans le support du papier point&eacute;.</p>\n            </div>\n          </div>\n\n          <h3 class=\"font-heading text-3xl font-bold mt-16 mb-6\" data-kid=\"66\">D&eacute;roulement</h3>\n          <p class=\"mb-6\" data-kid=\"67\">\n            Cette activit&eacute; a &eacute;t&eacute; con&ccedil;ue pour &ecirc;tre r&eacute;alis&eacute;e en version <strong data-kid=\"68\">Apprenti G&eacute;om&egrave;tre mobile</strong> ou en version papier. Le fichier ci-dessous explique le d&eacute;roulement en version Apprenti G&eacute;om&egrave;tre et en version papier.\n          </p>\n          <p class=\"mb-12\" data-kid=\"69\">\n            Les quelques diff&eacute;rences entre les versions Apprenti G&eacute;om&egrave;tre et Apprenti G&eacute;om&egrave;tre mobile sont reprises dans Modifications.\n          </p>\n\n          <h3 class=\"font-heading text-2xl font-bold mt-12 mb-6 flex items-center gap-2\" data-kid=\"70\">\n            <i class=\"ti ti-bulb text-[#FF7F50]\" data-kid=\"71\"></i>\n            Comment proc&eacute;der ?\n          </h3>\n          <ul class=\"space-y-4 mb-16\" data-kid=\"72\">\n            <li class=\"flex items-start gap-3\" data-kid=\"73\">\n              <i class=\"ti ti-circle-check-filled text-[#6dcfab] text-2xl mt-1\" data-kid=\"74\"></i>\n              <span data-kid=\"75\">Mesurez pr&eacute;cis&eacute;ment un segment de r&eacute;f&eacute;rence sur la figure de d&eacute;part.</span>\n            </li>\n            <li class=\"flex items-start gap-3\" data-kid=\"76\">\n              <i class=\"ti ti-circle-check-filled text-[#6dcfab] text-2xl mt-1\" data-kid=\"77\"></i>\n              <span data-kid=\"78\">Appliquez le multiplicateur entier &agrave; toutes les dimensions de la figure.</span>\n            </li>\n            <li class=\"flex items-start gap-3\" data-kid=\"79\">\n              <i class=\"ti ti-circle-check-filled text-[#6dcfab] text-2xl mt-1\" data-kid=\"80\"></i>\n              <span data-kid=\"81\">V&eacute;rifiez que les angles restent identiques pour conserver la forme.</span>\n            </li>\n          </ul>\n\n          \n          <div class=\"mt-20 pt-8 border-t border-dashed border-[#2A3439]/10 flex items-center justify-between\" data-kid=\"82\">\n            <a href=\"https://firebasestorage.googleapis.com/v0/b/project-359443804751131057.appspot.com/o/publications%2FM%26M.pdf?alt=media&token=6553ef4e-bf19-485e-9540-7a4175001ec1#page=167\" target=\"_blank\" class=\"flex items-center gap-2 text-[#2A3439]/60 hover:text-[#FF7F50] transition-colors font-medium\" data-kid=\"83\">\n              <i class=\"ti ti-link text-lg\" data-kid=\"84\"></i>\n              <span data-kid=\"85\">Source: CREM &ndash; Agrandissements</span>\n              <i class=\"ti ti-external-link text-sm\" data-kid=\"86\"></i>\n            </a>\n          </div>\n        </div>\n      </article>\n\n      \n      <aside class=\"lg:col-span-4 space-y-10\" data-kid=\"87\">\n        \n        \n        <div class=\"bg-[#FF7F50] rounded-[32px] p-8 text-white relative shadow-[0_20px_40px_rgba(255,127,80,0.25)]\" data-kid=\"88\">\n          <div class=\"absolute -top-6 -right-4 w-20 h-20 bg-white rounded-full flex items-center justify-center shadow-lg transform rotate-12\" data-kid=\"89\">\n            <i class=\"ti ti-bulb text-[#FF7F50] text-4xl\" data-kid=\"90\"></i>\n          </div>\n          <h4 class=\"font-heading text-2xl font-bold mb-4 text-white\" data-kid=\"91\">Le saviez-vous ?</h4>\n          <p class=\"text-white/90 leading-relaxed font-medium\" data-kid=\"92\">\n            Lorsque vous multipliez les c&ocirc;t&eacute;s d'un carr&eacute; par 3, vous pouvez loger exactement 9 petits carr&eacute;s dans le grand ! C'est parce que l'aire grandit beaucoup plus vite que les c&ocirc;t&eacute;s.\n          </p>\n        </div>\n\n        \n        <div class=\"bg-white/50 border-2 border-dashed border-[#FF7F50]/20 rounded-[32px] p-8\" data-kid=\"93\">\n          <h4 class=\"font-heading text-xl font-bold mb-6 flex items-center gap-2 text-[#2A3439]\" data-kid=\"94\">\n            <i class=\"ti ti-files text-[#FF7F50]\" data-kid=\"95\"></i>\n            Documents\n          </h4>\n          <div class=\"space-y-4\" data-kid=\"96\">\n            \n            <div class=\"doc-card flex flex-col gap-4 group cursor-default\" data-kid=\"97\">\n              <div class=\"flex items-center gap-3\" data-kid=\"98\">\n                <div class=\"w-10 h-10 bg-[#FFD1DC] rounded-xl flex items-center justify-center text-[#2A3439] shadow-inner\" data-kid=\"99\">\n                  <i class=\"ti ti-file-type-pdf text-xl\" data-kid=\"100\"></i>\n                </div>\n                <span class=\"font-heading font-semibold text-sm leading-tight group-hover:text-[#FF7F50] transition-colors\" data-kid=\"101\">Agrandissement_fiches</span>\n              </div>\n              <button class=\"puffy-button-sm flex items-center justify-center gap-2 w-full cursor-pointer\" data-kid=\"102\">\n                <i class=\"ti ti-download\" data-kid=\"103\"></i>\n                <span data-kid=\"104\">T&eacute;l&eacute;charger</span>\n              </button>\n            </div>\n            \n            <div class=\"doc-card flex flex-col gap-4 group cursor-default\" data-kid=\"105\">\n              <div class=\"flex items-center gap-3\" data-kid=\"106\">\n                <div class=\"w-10 h-10 bg-[#E0FFFF] rounded-xl flex items-center justify-center text-[#2A3439] shadow-inner\" data-kid=\"107\">\n                  <i class=\"ti ti-file-zip text-xl\" data-kid=\"108\"></i>\n                </div>\n                <span class=\"font-heading font-semibold text-sm leading-tight group-hover:text-[#FF7F50] transition-colors\" data-kid=\"109\">Agrandissements_fichiers_AGm</span>\n              </div>\n              <button class=\"puffy-button-sm flex items-center justify-center gap-2 w-full cursor-pointer\" data-kid=\"110\">\n                <i class=\"ti ti-download\" data-kid=\"111\"></i>\n                <span data-kid=\"112\">T&eacute;l&eacute;charger</span>\n              </button>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"bg-white/50 border-2 border-dashed border-[#2A3439]/10 rounded-[32px] p-8\" data-kid=\"113\">\n          <h4 class=\"font-heading text-xl font-bold mb-4 flex items-center gap-2 text-[#2A3439]\" data-kid=\"114\">\n            <i class=\"ti ti-info-circle text-[#FF7F50]\" data-kid=\"115\"></i>\n            Conseils rapides\n          </h4>\n          <div class=\"space-y-4 text-sm font-medium\" data-kid=\"116\">\n            <div class=\"p-4 bg-white rounded-2xl shadow-sm border border-black/5\" data-kid=\"117\">Utilisez le quadrillage pour compter les unit&eacute;s facilement.</div>\n            <div class=\"p-4 bg-white rounded-2xl shadow-sm border border-black/5\" data-kid=\"118\">V&eacute;rifiez toujours le rapport de multiplication sur deux c&ocirc;t&eacute;s diff&eacute;rents.</div>\n          </div>\n        </div>\n      </aside>\n\n    </div>\n\n    \n    <section class=\"mt-20\" data-kid=\"119\">\n      <div class=\"bg-[#E0FFFF] rounded-[40px] p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-[inset_-10px_-10px_20px_rgba(0,0,0,0.02),0_20px_40px_rgba(224,255,255,0.4)] border border-white/50\" data-kid=\"120\">\n        <div class=\"max-w-xl text-center md:text-left\" data-kid=\"121\">\n          <h2 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"122\">Pr&ecirc;t &agrave; relever le d&eacute;fi ?</h2>\n          <p class=\"text-lg font-medium opacity-80\" data-kid=\"123\">Mettez en pratique vos connaissances sur les agrandissements avec notre module interactif.</p>\n        </div>\n        <button class=\"puffy-button px-10 py-5 rounded-full font-heading font-bold text-xl flex items-center gap-3 whitespace-nowrap\" data-kid=\"124\">\n          <span data-kid=\"125\">Pratiquer cette notion</span>\n          <i class=\"ti ti-pencil text-2xl\" data-kid=\"126\"></i>\n        </button>\n      </div>\n    </section>\n\n  </main>\n\n  \n  <footer class=\"py-10 text-center opacity-40 font-medium text-sm\" data-kid=\"127\">\n    &copy; 2026 Apprenti G&eacute;om&egrave;tre mobile &mdash; Cr&eacute;&eacute; avec passion pour l'&eacute;ducation.\n  </footer>\n</div>\n",
