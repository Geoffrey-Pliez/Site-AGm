      "html": "<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=Fredoka:wght@400;600;700&display=swap');\n  @import url('https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,400;0,700;1,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  body {\n    background-color: #FFF8E7; /* Ivory Mist */\n    font-family: 'Nunito Sans', sans-serif;\n    color: #2A3439; /* Jet Black */\n    margin: 0;\n  }\n\n  .font-heading {\n    font-family: 'Fredoka', sans-serif;\n  }\n\n  /* Claymorphism Card Effect */\n  .clay-card {\n    background: #FFFFFF;\n    border-radius: 40px;\n    box-shadow: \n      inset -10px -10px 20px rgba(0, 0, 0, 0.02),\n      inset 10px 10px 20px rgba(255, 255, 255, 0.5),\n      20px 20px 60px rgba(42, 52, 57, 0.08);\n    border: 2px solid rgba(255, 255, 255, 0.8);\n  }\n\n  /* Puffy Button Effect */\n  .puffy-button {\n    background: #FF7F50; /* Coral Glow */\n    color: white;\n    box-shadow: \n      inset -4px -4px 8px rgba(0, 0, 0, 0.2),\n      inset 4px 4px 8px rgba(255, 255, 255, 0.3),\n      0 10px 20px rgba(255, 127, 80, 0.3);\n    transition: all 0.3s ease;\n  }\n  .puffy-button:hover {\n    transform: translateY(-2px);\n    box-shadow: \n      inset -2px -2px 4px rgba(0, 0, 0, 0.2),\n      inset 2px 2px 4px rgba(255, 255, 255, 0.3),\n      0 15px 30px rgba(255, 127, 80, 0.4);\n  }\n\n  /* Tag Styling */\n  .tag-sticker {\n    padding: 8px 20px;\n    border-radius: 999px;\n    font-weight: 700;\n    font-size: 0.875rem;\n    border: 3px solid white;\n    box-shadow: 0 4px 8px rgba(0, 0, 0, 0.05);\n    display: inline-block;\n    font-family: 'Fredoka', sans-serif;\n  }\n\n  /* Polaroid Effect */\n  .polaroid {\n    background: white;\n    padding: 16px 16px 48px 16px;\n    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);\n    transform: rotate(-2deg);\n    border-radius: 4px;\n  }\n\n  /* Washi Tape Effect */\n  .washi-tape {\n    position: absolute;\n    width: 100px;\n    height: 30px;\n    background: rgba(109, 207, 171, 0.4); /* Minty translucent */\n    top: -15px;\n    left: 50%;\n    transform: translateX(-50%) rotate(2deg);\n    z-index: 10;\n  }\n</style>\n\n<div class=\"min-h-[1200px] flex flex-col\" data-kid=\"1\">\n  \n  <header class=\"fixed top-6 left-1/2 -translate-x-1/2 w-[min(1200px,95%)] bg-white/70 backdrop-blur-xl rounded-[28px] shadow-[0_20px_50px_rgba(0,0,0,0.05)] z-50 px-10 py-5 flex justify-between items-center border border-white/40\" data-kid=\"2\">\n    <a href=\"#\" class=\"flex items-center gap-3 no-underline\" data-kid=\"3\">\n      <div class=\"w-12 h-12 flex items-center justify-center\" data-kid=\"4\">\n        \n        <img src=\"https://cdn.jsdelivr.net/npm/game-icons-transparent@latest/svgs/caro-asercion/paper-crane.svg\" class=\"w-10 h-10\" style=\"filter: drop-shadow(0 4px 6px rgba(255,127,80,0.4));\" data-kid=\"5\">\n      </div>\n      <span class=\"font-heading font-bold text-xl tracking-tight text-[#2A3439]\" data-kid=\"6\">Apprenti Géomètre mobile</span>\n    </a>\n    \n    <nav class=\"flex items-center gap-2\" data-kid=\"7\">\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"8\">Accueil</a>\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"9\">Prise en main</a>\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"10\">Modules</a>\n      <a href=\"#\" class=\"px-5 py-2.5 font-heading font-medium text-[#2A3439] hover:text-[#FF7F50] transition-colors\" data-kid=\"11\">Séquences</a>\n      <a href=\"#\" class=\"px-7 py-2.5 bg-[#E0FFFF] rounded-full font-heading font-bold text-[#2A3439] shadow-sm\" data-kid=\"12\">Tous les contenus</a>\n    </nav>\n  </header>\n\n  <main class=\"flex-grow pt-40 pb-20 px-8 max-w-7xl mx-auto w-full\" data-kid=\"13\">\n    \n    \n    <div class=\"relative mb-16\" data-kid=\"14\">\n      <div class=\"inline-block bg-[#2A3439] text-white px-12 py-8 rounded-tr-[40px] rounded-br-[40px] -ml-20 shadow-2xl relative z-10\" data-kid=\"15\">\n        <h1 class=\"font-heading text-4xl md:text-5xl lg:text-6xl font-bold leading-tight max-w-2xl\" data-kid=\"16\">\n          les côtés ont été multipliés par un nombre entier.\n        </h1>\n      </div>\n      \n      \n      <div class=\"mt-8 flex flex-wrap gap-4 pl-4\" data-kid=\"17\">\n        <span class=\"tag-sticker bg-[#FFD1DC]\" data-kid=\"18\">P5 - P6</span>\n        <span class=\"tag-sticker bg-[#E0FFFF]\" data-kid=\"19\">S1 à S3</span>\n        <span class=\"tag-sticker bg-[#C1E1C1]\" data-kid=\"20\">Aire</span>\n        <span class=\"tag-sticker bg-[#FDFD96]\" data-kid=\"21\">Reproduction de figures planes</span>\n        <span class=\"tag-sticker bg-[#B39EB5]\" data-kid=\"22\">Agrandir/Rétrécir</span>\n        <span class=\"tag-sticker bg-[#FFB347]\" data-kid=\"23\">Paver</span>\n        <span class=\"tag-sticker bg-[#AEC6CF]\" data-kid=\"24\">Aire séquence</span>\n        <span class=\"tag-sticker bg-[#FFD1DC]\" data-kid=\"25\">P5 - P6</span>\n      </div>\n    </div>\n\n    \n    <div class=\"grid grid-cols-1 lg:grid-cols-12 gap-10 items-start\" data-kid=\"26\">\n      \n      \n      <article class=\"lg:col-span-8 clay-card p-12 relative overflow-visible\" data-kid=\"27\">\n        <div class=\"prose prose-lg max-w-none text-[#2A3439] leading-relaxed\" data-kid=\"28\">\n          <p class=\"text-xl font-medium mb-8\" data-kid=\"29\">\n            Dans cet exercice, nous allons explorer comment les figures géométriques se transforment lorsque leurs dimensions sont multipliées par un facteur constant. C'est le concept fondamental de l'agrandissement et du rétrécissement.\n          </p>\n          \n          <div class=\"relative float-right ml-10 mb-10 w-80\" data-kid=\"30\">\n            \n            <div class=\"washi-tape\" data-kid=\"31\"></div>\n            \n            <div class=\"polaroid\" data-kid=\"32\">\n              <img src=\"/api/local/images/public/wp-content/uploads/2023/07/agrandissements.png\" alt=\"Illustration\" class=\"w-full aspect-square object-cover rounded-sm mb-4\" loading=\"lazy\" decoding=\"async\" data-kid=\"33\">\n              <p class=\"font-heading text-center text-gray-500 text-sm italic\" data-kid=\"34\">Observation des formes</p>\n            </div>\n          </div>\n\n          <p class=\"mb-6\" data-kid=\"35\">\n            L'agrandissement d'une figure conserve ses angles mais modifie ses longueurs. Si chaque côté est multiplié par 2, le périmètre est multiplié par 2, mais l'aire est multipliée par 4 (2 au carré). C'est une distinction cruciale à comprendre pour tout apprenti géomètre.\n          </p>\n          \n          <p class=\"mb-6\" data-kid=\"36\">\n            Observez attentivement la figure ci-contre. Le personnage utilise un appareil photo pour capturer des \"instants géométriques\". Chaque capture nous permet d'analyser les proportions et de vérifier si l'agrandissement est resté fidèle à la figure originale.\n          </p>\n\n          <h3 class=\"font-heading text-3xl font-bold mt-12 mb-6\" data-kid=\"37\">Comment procéder ?</h3>\n          <ul class=\"space-y-4\" data-kid=\"38\">\n            <li class=\"flex items-start gap-3\" data-kid=\"39\">\n              <i class=\"ti ti-circle-check-filled text-[#6dcfab] text-2xl mt-1\" data-kid=\"40\"></i>\n              <span data-kid=\"41\">Mesurez précisément un segment de référence sur la figure de départ.</span>\n            </li>\n            <li class=\"flex items-start gap-3\" data-kid=\"42\">\n              <i class=\"ti ti-circle-check-filled text-[#6dcfab] text-2xl mt-1\" data-kid=\"43\"></i>\n              <span data-kid=\"44\">Appliquez le multiplicateur entier à toutes les dimensions de la figure.</span>\n            </li>\n            <li class=\"flex items-start gap-3\" data-kid=\"45\">\n              <i class=\"ti ti-circle-check-filled text-[#6dcfab] text-2xl mt-1\" data-kid=\"46\"></i>\n              <span data-kid=\"47\">Vérifiez que les angles restent identiques pour conserver la forme.</span>\n            </li>\n          </ul>\n        </div>\n      </article>\n\n      \n      <aside class=\"lg:col-span-4 space-y-8\" data-kid=\"48\">\n        \n        <div class=\"bg-[#FF7F50] rounded-[32px] p-8 text-white relative shadow-[0_20px_40px_rgba(255,127,80,0.25)]\" data-kid=\"49\">\n          <div class=\"absolute -top-6 -right-4 w-20 h-20 bg-white rounded-full flex items-center justify-center shadow-lg transform rotate-12\" data-kid=\"50\">\n            <i class=\"ti ti-bulb text-[#FF7F50] text-4xl\" data-kid=\"51\"></i>\n          </div>\n          <h4 class=\"font-heading text-2xl font-bold mb-4\" data-kid=\"52\">Le saviez-vous ?</h4>\n          <p class=\"text-white/90 leading-relaxed font-medium\" data-kid=\"53\">\n            Lorsque vous multipliez les côtés d'un carré par 3, vous pouvez loger exactement 9 petits carrés dans le grand ! C'est parce que l'aire grandit beaucoup plus vite que les côtés.\n          </p>\n        </div>\n\n        \n        <div class=\"bg-white/50 border-2 border-dashed border-[#FF7F50]/30 rounded-[32px] p-8\" data-kid=\"54\">\n          <h4 class=\"font-heading text-xl font-bold mb-4 flex items-center gap-2\" data-kid=\"55\">\n            <i class=\"ti ti-info-circle text-[#FF7F50]\" data-kid=\"56\"></i>\n            Conseils rapides\n          </h4>\n          <div class=\"space-y-4 text-sm font-medium\" data-kid=\"57\">\n            <div class=\"p-4 bg-white rounded-2xl shadow-sm\" data-kid=\"58\">Utilisez le quadrillage pour compter les unités facilement.</div>\n            <div class=\"p-4 bg-white rounded-2xl shadow-sm\" data-kid=\"59\">Vérifiez toujours le rapport de multiplication sur deux côtés différents.</div>\n          </div>\n        </div>\n      </aside>\n\n    </div>\n\n    \n    <section class=\"mt-20\" data-kid=\"60\">\n      <div class=\"bg-[#E0FFFF] rounded-[40px] p-12 flex flex-col md:flex-row items-center justify-between gap-8 shadow-[inset_-10px_-10px_20px_rgba(0,0,0,0.02),0_20px_40px_rgba(224,255,255,0.4)] border border-white/50\" data-kid=\"61\">\n        <div class=\"max-w-xl text-center md:text-left\" data-kid=\"62\">\n          <h2 class=\"font-heading text-4xl font-bold mb-4\" data-kid=\"63\">Prêt à relever le défi ?</h2>\n          <p class=\"text-lg font-medium opacity-80\" data-kid=\"64\">Mettez en pratique vos connaissances sur les agrandissements avec notre module interactif.</p>\n        </div>\n        <button class=\"puffy-button px-10 py-5 rounded-full font-heading font-bold text-xl flex items-center gap-3 whitespace-nowrap\" data-kid=\"65\">\n          <span data-kid=\"66\">Pratiquer cette notion</span>\n          <i class=\"ti ti-pencil text-2xl\" data-kid=\"67\"></i>\n        </button>\n      </div>\n    </section>\n\n  </main>\n\n  \n  <footer class=\"py-10 text-center opacity-40 font-medium text-sm\" data-kid=\"68\">\n    &copy; 2026 Apprenti Géomètre mobile — Créé avec passion pour l'éducation.\n  </footer>\n</div>",
      "comments": [],
