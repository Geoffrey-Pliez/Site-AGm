---
import { INSTALL_URL, tryGetAppLink } from "../lib/appLink";

interface Props {
  slug: string;
  label?: string;
  fallbackPrefix?: string;
  showQr?: boolean;
}

const { slug, label = "Tester dans l'appli", fallbackPrefix, showQr = true } = Astro.props;
const appUrl = tryGetAppLink(slug);
---

{appUrl ? (
  <div class="app-cta">
    <a class="button primary" href={appUrl} target="_blank" rel="noreferrer">{label}</a>
    <p class="app-cta-fallback">
      {fallbackPrefix ? `${fallbackPrefix} ` : ""}Appli non installée ? <a href={INSTALL_URL} target="_blank" rel="noreferrer">Installer AGm</a>
    </p>
    {showQr && (
      <img src={`https://api.qrserver.com/v1/create-qr-code/?size=140x140&data=${encodeURIComponent(appUrl)}`} alt={`QR code vers ${appUrl}`} loading="lazy" width="140" height="140" />
    )}
  </div>
) : (
  <div class="app-cta">
    <span class="button primary disabled" aria-disabled="true">{label}</span>
  </div>
)}

<style>
  .app-cta {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    margin: 1rem 0;
  }
  .app-cta-fallback {
    margin: 0;
    font-size: 0.9rem;
  }
</style>
