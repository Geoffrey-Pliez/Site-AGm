---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MigratedContentCard from "../../components/MigratedContentCard.astro";
import wpData from "../../data/wp-content.json";

const modules = wpData.content.filter((item) => item.type === "post");
const themes = [...new Set(modules.flatMap((item) => item.terms.themes ?? []))].sort((a, b) => a.localeCompare(b, "fr"));
const actions = [...new Set(modules.flatMap((item) => item.terms.actions ?? []))].sort((a, b) => a.localeCompare(b, "fr"));
const levels = [...new Set(modules.flatMap((item) => item.terms.niveau ?? []))].sort((a, b) => a.localeCompare(b, "fr"));
const categories = [...new Set(modules.flatMap((item) => item.terms.categories ?? []))].sort((a, b) => a.localeCompare(b, "fr"));
---

<BaseLayout title="Modules - Apprenti Géomètre mobile">
  <section class="page-intro">
    <p class="eyebrow">Composer un parcours</p>
    <h1>Modules et fiches d'activité</h1>
    <p>
      La fiche d'activité décrit la tâche que l'élève doit réaliser sur le logiciel.
      Certaines fiches sont associées à des synthèses et à des documents pour la classe.
    </p>
  </section>

  <section class="catalog">
    <aside class="filters" aria-label="Filtres des modules">
      <label>
        Recherche
        <input data-filter-search type="search" placeholder="Titre, objectif..." />
      </label>
      <label>
        Thème
        <select data-filter="themes">
          <option value="">Tous les thèmes</option>
          {themes.map((theme) => <option value={theme}>{theme}</option>)}
        </select>
      </label>
      <label>
        Action
        <select data-filter="actions">
          <option value="">Toutes les actions</option>
          {actions.map((action) => <option value={action}>{action}</option>)}
        </select>
      </label>
      <label>
        Niveau
        <select data-filter="levels">
          <option value="">Tous les niveaux</option>
          {levels.map((level) => <option value={level}>{level}</option>)}
        </select>
      </label>
      <label>
        Catégorie
        <select data-filter="categories">
          <option value="">Toutes les catégories</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <p class="result-count"><span data-result-count>{modules.length}</span> ressources</p>
    </aside>
    <div class="catalog-list">
      {modules.map((item) => <MigratedContentCard item={item} />)}
    </div>
  </section>

  <script>
    const cards = [...document.querySelectorAll("[data-migrated-card]")];
    const selects = [...document.querySelectorAll("[data-filter]")];
    const search = document.querySelector("[data-filter-search]");
    const count = document.querySelector("[data-result-count]");

    function updateCards() {
      const query = search.value.trim().toLowerCase();
      let visible = 0;

      cards.forEach((card) => {
        const matchesQuery = !query || card.dataset.title.includes(query) || card.textContent.toLowerCase().includes(query);
        const matchesSelects = selects.every((select) => {
          const value = select.value;
          return !value || (card.dataset[select.dataset.filter] || "").split("|").includes(value);
        });
        const shouldShow = matchesQuery && matchesSelects;
        card.hidden = !shouldShow;
        if (shouldShow) visible += 1;
      });

      count.textContent = String(visible);
    }

    selects.forEach((select) => select.addEventListener("change", updateCards));
    search.addEventListener("input", updateCards);
  </script>
</BaseLayout>
