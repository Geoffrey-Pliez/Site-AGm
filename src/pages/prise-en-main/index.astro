---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MigratedContentCard from "../../components/MigratedContentCard.astro";
import wpData from "../../data/wp-content.json";

const starters = wpData.content.filter((item) => {
  const terms = [
    ...(item.terms.themes ?? []),
    ...(item.terms.categories ?? []),
  ].join(" ").toLowerCase();
  return terms.includes("prise en main") || terms.includes("initiation") || terms.includes("découvrir");
});
---

<BaseLayout title="Prise en main - Apprenti Géomètre mobile">
  <section class="page-intro compact">
    <p class="eyebrow">Démarrer</p>
    <h1>Prise en main du logiciel</h1>
    <p>
      Les premiers modules aident les élèves à comprendre les gestes essentiels : manipuler,
      construire, déplacer et modifier des figures.
    </p>
  </section>

  <section class="split-content">
    <img src="https://agmobile.crem.be/wp-content/uploads/2021/07/prisemain2.png" alt="Prise en main AGmobile" />
    <div>
      <h2>Un micro-monde à explorer</h2>
      <p>
        Le logiciel laisse l'initiative à l'utilisateur. La prise en main est donc pensée comme une
        exploration guidée : on observe, on manipule, puis on formule les propriétés utiles.
      </p>
      <a class="button primary" href="https://ag.crem.be/" target="_blank" rel="noreferrer">Ouvrir le logiciel</a>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Modules d'initiation</p>
      <h2>Commencer avec les ressources CREM</h2>
    </div>
    <div class="card-grid">
      {starters.map((item) => <MigratedContentCard item={item} />)}
    </div>
  </section>
</BaseLayout>
