---
import BaseLayout from "../../layouts/BaseLayout.astro";
import MigratedContentCard from "../../components/MigratedContentCard.astro";
import wpData from "../../data/wp-content.json";
import { sequences as curatedSequences, getLinkedFiches } from "../../data/site";

const sequences = wpData.content.filter((item) => {
  const categories = item.terms.categories ?? [];
  return categories.some((category) => category.toLowerCase().includes("séquence"));
});
---

<BaseLayout title="Séquences d'apprentissage - Apprenti Géomètre mobile">
  <section class="page-intro">
    <p class="eyebrow">Parcours pour la classe</p>
    <h1>Séquences d'apprentissage</h1>
    <p>
      Une séquence construit un ensemble de connaissances ou de savoir-faire par une suite
      d'activités réparties dans le temps et sélectionnées par l'enseignant.
    </p>
  </section>

  <section class="split-content">
    <img src="https://agmobile.crem.be/wp-content/uploads/2021/07/sequences-dapprentissage-1-1024x591.png" alt="Présentation d'une page de séquence AGmobile" />
    <div>
      <h2>Utiliser ou créer ses séquences</h2>
      <p>
        Les séquences proposées sont des agencements de modules. Elles peuvent aussi servir de
        base pour composer vos propres parcours en fonction du niveau, du thème et de l'action visée.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Modules curatés</p>
      <h2>Fiches liées aux modules</h2>
      <p>
        Chaque fiche ci-dessous pointe vers son module parent via son
        <code>moduleSlug</code>, sans changer les slugs existants.
      </p>
    </div>
    <div class="card-grid">
      {curatedSequences.map((sequence) => {
        const fiches = getLinkedFiches(sequence.slug);
        const linked = fiches.length ? fiches : null;
        return (
          <article class="module-card" data-sequence-card data-slug={sequence.slug}>
            <div class="module-body">
              <p class="eyebrow">{sequence.type}</p>
              <h2><a href={`/modules/${sequence.slug}/`}>{sequence.title}</a></h2>
              <p>{sequence.excerpt}</p>
              {linked ? (
                <ul class="resource-list">
                  {linked.map((fiche) => (
                    <li><a href={`/modules/${fiche.slug}/`}>{fiche.title}</a></li>
                  ))}
                </ul>
              ) : (
                <p>Aucune fiche liée pour le moment.</p>
              )}
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">Dernières séquences</p>
      <h2>Ressources prêtes à assembler</h2>
    </div>
    <div class="card-grid">
      {sequences.map((item) => <MigratedContentCard item={item} />)}
    </div>
  </section>
</BaseLayout>
