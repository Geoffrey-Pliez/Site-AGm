---
import "../styles/global.css";

const {
  title = "Administration | Apprenti Géomètre mobile",
  description = "Administration du site Apprenti Géomètre mobile",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style>
      html, body {
        height: 100%;
        margin: 0;
      }
      body {
        display: flex;
        flex-direction: column;
      }
      .admin-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 0.5rem 1.5rem;
        background: var(--ink);
        color: white;
        font-size: 0.9rem;
        flex-shrink: 0;
      }
      .admin-topbar a {
        color: white;
        text-decoration: none;
        font-weight: 700;
      }
      .admin-topbar a:hover {
        text-decoration: underline;
      }
      .admin-topbar span {
        opacity: 0.75;
      }
      main {
        flex: 1;
        display: flex;
        flex-direction: column;
        padding: 0 1.5rem 1.5rem;
        overflow: auto;
      }
    </style>
  </head>
  <body>
    <div class="admin-topbar">
      <a href="/">&larr; Retour au site</a>
      <span>Administration AGm</span>
    </div>
    <main>
      <slot />
    </main>
  </body>
</html>
