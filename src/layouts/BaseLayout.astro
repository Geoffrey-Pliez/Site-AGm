---
import "../styles/global.css";

const {
  title = "Apprenti Géomètre mobile",
  description = "Logiciel de géométrie dynamique - CREM asbl",
} = Astro.props;

const nav = [
  { href: "/", label: "Accueil" },
  { href: "/prise-en-main/", label: "Prise en main" },
  { href: "/modules/", label: "Modules" },
  { href: "/sequences/", label: "Séquences" },
  { href: "/contenus/", label: "Tous les contenus" },
];
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <title>{title}</title>

      <!-- 🐛 Auto bug reporting -->
      <script type="module">
        import { actions } from "astro:actions";

        function getStack(error) {
          if (error?.stack) return error.stack;
          if (typeof error === "string") return error;
          return String(error);
        }

        async function reportBug(message, stack) {
          try {
            const res = await actions.reportBug({
              message: message.slice(0, 500),
              stack: stack?.slice(0, 8000),
              url: location.href,
              userAgent: navigator.userAgent,
            });
            if (res.data?.issueUrl) {
              console.info("🐛 Bug reporté →", res.data.issueUrl);
            }
          } catch (e) {
            // Fail silencieux : ne pas créer de boucle infinie
            console.warn("Bug report échoué", e);
          }
        }

        // Erreurs globales
        window.addEventListener("error", (event) => {
          const msg = event.error?.message || event.message || "Unknown error";
          reportBug(msg, getStack(event.error));
        });

        // Promesses non gérées
        window.addEventListener("unhandledrejection", (event) => {
          const reason = event.reason;
          const msg = reason?.message || String(reason);
          reportBug(msg, getStack(reason));
        });
      </script>
    </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">
        <img src="/wp-content/uploads/2021/01/cropped-AGmobilelogo.png" alt="" />
        <span>Apprenti Géomètre mobile</span>
      </a>
      <nav aria-label="Navigation principale">
        {
          nav.map((item) => (
            <a href={item.href} aria-current={Astro.url.pathname === item.href ? "page" : undefined}>
              {item.label}
            </a>
          ))
        }
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div>
        <h2>Souhaitez-vous ?</h2>
        <p>Participer à une formation pour prendre en main le logiciel ou devenir une école partenaire.</p>
        <a href="mailto:info@crem.be">info@crem.be</a>
      </div>
      <div class="footer-logo">
        <img src="/wp-content/uploads/2021/01/cropped-AGmobilelogo.png" alt="AGmobile" />
      </div>
      <div>
        <h2>CREM asbl</h2>
        <p>Suivez les ressources et publications du CREM.</p>
        <p class="footer-links">
          <a href="https://www.crem.be/" target="_blank" rel="noreferrer">Site CREM</a>
          <a href="https://www.facebook.com/crem.asbl" target="_blank" rel="noreferrer">Facebook</a>
          <a href="https://www.youtube.com/channel/UCdft9xLz0UTTpFDKyDEnZAQ" target="_blank" rel="noreferrer">YouTube</a>
          <a href="/admin/">Administration</a>
        </p>
      </div>
    </footer>
  </body>
</html>
